# Copy to .env and edit.

# Your Brightspace ("NOW") base URL -- no trailing slash.
NOW_BASE_URL=https://now.ntu.ac.uk

# Where the saved browser session (cookies) lives. Treat like a password.
NOW_STATE_DIR=./state

# Where downloaded module content goes.
NOW_DATA_DIR=./data

# Your timezone, for human-readable dates in tool output.
NOW_TIMEZONE=Europe/London

# --- Remote (HTTP) mode only -------------------------------------------
# A long random string. The MCP endpoint becomes /<secret>/mcp so that
# nobody can find the server without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NOW_HTTP_SECRET=change-me

# The public hostname Claude will connect to, e.g. now-mcp.yourdomain.com or
# the trycloudflare.com address a tunnel gives you. Requests with any other
# Host header are rejected (421). Leave empty to skip that check.
NOW_PUBLIC_HOST=

# Bind address/port for the HTTP server (keep 127.0.0.1 behind Caddy).
NOW_HTTP_HOST=127.0.0.1
NOW_HTTP_PORT=8765

# Optional server-maintenance (ops) service. Off by default; set OPS_ENABLE=1 and
# re-run deploy/setup-vps.sh to install it. See README "Maintenance by Claude".
OPS_ENABLE=0
# Secret path for the ops service; generated by setup-vps.sh.
# Anyone with this URL can administer the server, so it never leaves .env and
# claude.ai's connector settings.
OPS_SECRET=
# Set to 1 to also let the ops service run arbitrary commands (off by default).
OPS_ALLOW_SHELL=0

# Keep the NOW session warm by pinging it every N minutes (0 = off).
NOW_KEEPALIVE_MINUTES=20
